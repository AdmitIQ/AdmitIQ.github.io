# AdmitIQ server configuration. Copy to .env and fill in what you want to enable.
# EVERYTHING HERE IS OPTIONAL — without any of it, AdmitIQ runs fully in local mode
# (all non-AI features, rule-based strategist, heuristic essay analysis, offline research).
# Keys are read only by server/server.mjs and are never sent to the browser.

PORT=8787
# Set to true when running behind a reverse proxy (Render, Fly, Nginx) so rate limiting sees real client IPs.
TRUST_PROXY=false
# Requests per minute per IP for /api/ai and /api/scorecard (research costs 3).
RATE_LIMIT_PER_MIN=20

# ---------- AI provider (optional) ----------
# One of: none | ollama | groq | gemini | openrouter | openai | anthropic | openai-compatible
#   ollama            free, runs on your own machine (https://ollama.com) — no key needed
#   groq / gemini / openrouter   offer free tiers with rate limits (check each provider's current pricing)
#   openai / anthropic           paid, usage-based
#   openai-compatible            any server exposing /v1/chat/completions (LM Studio, vLLM, Together…); set AI_BASE_URL
AI_PROVIDER=none
AI_API_KEY=
# Optional overrides (each provider has a sensible default model — set this if the default is retired)
AI_MODEL=
AI_BASE_URL=

# ---------- College Scorecard (optional, free) ----------
# Official U.S. Dept. of Education data. Free key: https://api.data.gov/signup
# Enables live lookups in the Research center and `npm run sync:scorecard` (marks data as Verified).
SCORECARD_API_KEY=

# ---------- Web search for the Research center (optional) ----------
# tavily | brave  — both have their own pricing/free allowances; check before enabling.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ---------- Accounts & sync (optional, Supabase free tier compatible) ----------
# Project Settings → API. The anon key is designed to be public; row-level security protects data.
# NEVER put the service_role key here or anywhere in the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# When true, /api/ai and /api/research require a signed-in Supabase user (stops strangers using your AI key).
REQUIRE_AUTH=false
